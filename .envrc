watch_file toolchain.env
source_env toolchain.env

project_root="$(pwd -P)"
ghcup_bin="${GHCUP_BIN:-$HOME/.ghcup/bin/ghcup}"
toolchain_bin="$project_root/.direnv/ghcup/bin"
local_bin="$project_root/.direnv/bin"
local_lib="$project_root/.direnv/lib"

if [[ ! -x "$ghcup_bin" ]]; then
  echo "Markovian: ghcup is missing at $ghcup_bin" >&2
  echo "Markovian: install GHCup, then run scripts/bootstrap-tools" >&2
  return 1
fi

mkdir -p "$toolchain_bin" "$local_bin" "$local_lib"

if ! "$ghcup_bin" run --quick \
  --ghc "$MARKOVIAN_GHC_VERSION" \
  --cabal "$MARKOVIAN_CABAL_VERSION" \
  --hls "$MARKOVIAN_HLS_VERSION" \
  --tool "fourmolu,$MARKOVIAN_FOURMOLU_VERSION" \
  --bindir "$toolchain_bin" >/dev/null; then
  echo "Markovian: the pinned GHCup toolchain is incomplete" >&2
  echo "Markovian: run scripts/bootstrap-tools" >&2
  return 1
fi

PATH_add "$toolchain_bin"
PATH_add "$local_bin"
export LIBRARY_PATH="$local_lib${LIBRARY_PATH:+:$LIBRARY_PATH}"
export MARKOVIAN_TOOLCHAIN="ghc-$MARKOVIAN_GHC_VERSION"

if [[ ! -x "$local_bin/hlint" || ! -x "$local_bin/cabal-fmt" ]]; then
  echo "Markovian: optional project tools are missing; run scripts/bootstrap-tools" >&2
fi
