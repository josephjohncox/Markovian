cabal-version:      3.4
name:               Markovian
version:            2026.9.3.0
synopsis:           Exact finite stochastic structure and decision semantics
description:
  Base-only exact and exact-neutral interfaces for finite stochastic structure,
  decision models, bounded interpreters, circuits, games, and open systems.

category:           Math
homepage:           https://github.com/josephjohncox/Markovian
bug-reports:        https://github.com/josephjohncox/Markovian/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Joseph Cox
maintainer:         joseph@codensity.io
copyright:          2024-2026 Joseph Cox
build-type:         Simple
stability:          Experimental
tested-with:        GHC ==9.4.8 || ==9.8.4
