executable MixedGamesExample
  import:           warnings
  main-is:          Main.hs
  build-depends:
    , base       >=4.17.2.1   && <4.20
    , Markovian  ==2026.9.3.0

  hs-source-dirs:   examples/games/exact
  default-language: GHC2021

