cabal-version:      3.4
name:               Markovian
version:            0.1.0.0
synopsis:           Validated finite stochastic kernels and decision models
description:
  Experimental Haskell interfaces for finite stochastic kernels, Markov reward
  processes, Markov decision processes, policies, and bounded interpreters.

category:           Math
homepage:           https://github.com/josephjohncox/Markovian
bug-reports:        https://github.com/josephjohncox/Markovian/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Joseph Cox
maintainer:         joseph@codensity.io
build-type:         Simple
extra-doc-files:
  CHANGELOG.md
  docs/ARCHITECTURE.md
  docs/CONTEXT.md
  docs/DECISIONS.md
  docs/WORKFLOWS.md
  README.md
  TODO.md

extra-source-files:
  .envrc
  .github/workflows/ci.yml
  .gitleaks.toml
  cabal.project.ci
  hie.yaml
  scripts/bootstrap-tools
  scripts/check-circuit-purity
  scripts/check-refinement-roles
  test/compile-fail/CircuitPurity.hs
  test/compile-fail/PushoutKind.hs
  test/compile-fail/RefinementRoles.hs
  toolchain.env

source-repository head
  type:     git
  location: https://github.com/josephjohncox/Markovian.git

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:
    Markovian.Algebra.NonNegativeRational
    Markovian.Algebra.Semiring
    Markovian.Backend.CPU.Exact
    Markovian.Bayesian.Channel.Exact
    Markovian.Bayesian.Exact
    Markovian.Category.Convex.Exact
    Markovian.Category.Finite.Exact
    Markovian.Category.Finite.Object
    Markovian.Category.Finite.Set
    Markovian.Category.Matrix
    Markovian.Category.Matrix.Deterministic
    Markovian.Category.Matrix.Stochastic
    Markovian.Circuit
    Markovian.Circuit.Compile.Deterministic
    Markovian.Circuit.Interpret.Approximate
    Markovian.Circuit.Interpret.Exact
    Markovian.Compile.Exact
    Markovian.Horizon
    Markovian.Interpreter.Bellman.Exact
    Markovian.Interpreter.DynamicProgramming.Exact
    Markovian.Interpreter.Exact
    Markovian.Interpreter.Sampled
    Markovian.Kernel
    Markovian.Kernel.Exact
    Markovian.Learning.QLearning
    Markovian.Learning.QLearning.Episodic
    Markovian.MDP
    Markovian.MDP.Exact
    Markovian.MRP
    Markovian.Objective
    Markovian.Objective.Exact
    Markovian.Open.Circuit.Exact
    Markovian.Open.Hypergraph
    Markovian.Open.Interface
    Markovian.Open.Pushout
    Markovian.Open.StructuredCospan
    Markovian.Policy
    Markovian.Policy.Exact
    Markovian.POMDP.Exact
    Markovian.POMDP.Planning.Exact
    Markovian.Probability
    Markovian.Probability.Exact
    Markovian.Reward
    Markovian.Reward.Exact
    Markovian.Sampling
    Markovian.Trace

  other-modules:
    Markovian.Category.Finite.Set.Internal
    Markovian.Category.Matrix.Stochastic.Internal

  build-depends:    base >=4.17.2.1 && <4.20
  hs-source-dirs:   src
  default-language: GHC2021

executable Sample
  import:           warnings
  main-is:          Main.hs
  build-depends:
    , base       >=4.17.2.1 && <4.20
    , Markovian

  hs-source-dirs:   app/Sample
  default-language: GHC2021

test-suite Markovian-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:
    AlgebraicFoundation
    BayesianExact
    OpenSystems
    StochasticCircuit

  build-depends:
    , base       >=4.17.2.1 && <4.20
    , Markovian

  hs-source-dirs:   test
  default-language: GHC2021
