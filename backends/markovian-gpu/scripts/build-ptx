#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${root}/toolchain.env"

cuda_root="$(cd "$(dirname "${MARKOVIAN_NVCC}")/.." && pwd)"
cuda_header="${cuda_root}/include/cuda.h"
test -f "${cuda_header}"
printf '%s  %s\n' "${MARKOVIAN_CUDA_DRIVER_HEADER_SHA256}" "${cuda_header}" | sha256sum --check --status

actual_version="$("${MARKOVIAN_NVCC}" --version | awk '/release/ {gsub(/,/, "", $5); print $5}')"
if [[ "${actual_version}" != "${MARKOVIAN_CUDA_VERSION}" ]]; then
  echo "Expected CUDA ${MARKOVIAN_CUDA_VERSION}, found ${actual_version}." >&2
  exit 1
fi

"${MARKOVIAN_NVCC}" \
  -ptx \
  -arch="compute_${MARKOVIAN_CUDA_COMPUTE_CAPABILITY}" \
  "${root}/cbits/markovian_dense.cu" \
  -o "${root}/cbits/markovian_dense.ptx"

python3 - "${root}" <<'PY'
from hashlib import sha256
from pathlib import Path
import re
import sys

root = Path(sys.argv[1])
ptx_path = root / "cbits/markovian_dense.ptx"
raw = ptx_path.read_bytes()
source = raw.decode("utf-8")
target_match = re.search(r"^\.target\s+(\S+)\s*$", source, re.MULTILINE)
kernel_match = re.search(r"^\.visible\s+\.entry\s+(\w+)\(", source, re.MULTILINE)
if target_match is None or kernel_match is None:
    raise SystemExit("generated PTX is missing its target or entry declaration")
target = target_match.group(1)
kernel = kernel_match.group(1)
abi = "markovian-f64-matmul-v1"
digest = sha256(raw).hexdigest()

lines = [
    "#ifndef MARKOVIAN_DENSE_PTX_H",
    "#define MARKOVIAN_DENSE_PTX_H",
    "",
    "#include <stddef.h>",
    "",
    f'#define MARKOVIAN_DENSE_PTX_TARGET "{target}"',
    f'#define MARKOVIAN_DENSE_PTX_KERNEL "{kernel}"',
    f'#define MARKOVIAN_DENSE_KERNEL_ABI "{abi}"',
    f'#define MARKOVIAN_DENSE_PTX_SHA256 "{digest}"',
    "",
    "static const char markovian_dense_ptx[] =",
]
for line in source.replace("\\", "\\\\").replace('"', '\\"').splitlines():
    lines.append(f'    "{line}\\n"')
lines.extend([
    "    ;",
    "static const size_t markovian_dense_ptx_length = sizeof(markovian_dense_ptx) - 1U;",
    "",
    "#endif",
    "",
])
(root / "cbits/markovian_dense_ptx.h").write_text("\n".join(lines))

haskell = f'''-- Generated by scripts/build-ptx from cbits/markovian_dense.ptx.
module Markovian.Backend.GPU.Artifact where

ptxTarget :: String
ptxTarget = {target!r}

kernelName :: String
kernelName = {kernel!r}

kernelABI :: String
kernelABI = {abi!r}

ptxSHA256 :: String
ptxSHA256 = {digest!r}

ptxLength :: Integer
ptxLength = {len(raw)}
'''.replace("'", '"')
artifact_path = root / "src/Markovian/Backend/GPU/Artifact.hs"
artifact_path.parent.mkdir(parents=True, exist_ok=True)
artifact_path.write_text(haskell)
PY

printf '%s  %s\n' "${MARKOVIAN_CUDA_PTX_SHA256}" "${root}/cbits/markovian_dense.ptx" | sha256sum --check --status
printf '%s  %s\n' "${MARKOVIAN_CUDA_PTX_HEADER_SHA256}" "${root}/cbits/markovian_dense_ptx.h" | sha256sum --check --status
