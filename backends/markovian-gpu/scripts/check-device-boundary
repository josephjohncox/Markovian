#!/usr/bin/env bash
set -euo pipefail

package_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repository_root="$(cd "${package_dir}/../.." && pwd)"

if [[ -f "${repository_root}/cabal.project.ci" ]] \
  && [[ "$(realpath "${repository_root}/backends/markovian-gpu")" == "${package_dir}" ]]; then
  cd "${repository_root}"
  project_arguments=(--project-file=cabal.project.ci)
  fixture_prefix="backends/markovian-gpu/"
else
  cd "${package_dir}"
  project_arguments=()
  fixture_prefix=""
fi

check_failure() {
  local fixture="$1"
  shift
  local log_file
  log_file="$(mktemp)"
  if cabal exec "${project_arguments[@]}" -- ghc \
    -fno-code -fmax-errors=100 -package markovian-gpu \
    "${fixture_prefix}${fixture}" >"${log_file}" 2>&1; then
    rm -f "${log_file}"
    echo "Device boundary fixture unexpectedly compiled: ${fixture}" >&2
    exit 1
  fi
  for expected in "$@"; do
    if ! grep -F "${expected}" "${log_file}" >/dev/null; then
      cat "${log_file}" >&2
      rm -f "${log_file}"
      echo "Expected device rejection was absent: ${expected}" >&2
      exit 1
    fi
  done
  rm -f "${log_file}"
}

check_failure test/compile-fail/DeviceBoundary.hs \
  badPreparedConstructor badVJPConstructor badDeviceTensorConstructor \
  badExecutorConstructor badScopedEscape badShapeCoercion 'Illegal term-level use' \
  "Couldn't match type"

check_failure test/compile-fail/DeviceRoles.hs \
  badVJPCoercion badExecutorScopeCoercion "Couldn't match type"

echo "PASS: device plans, host results, executor resources, and endpoints remain protected"
