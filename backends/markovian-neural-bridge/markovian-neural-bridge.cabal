cabal-version:      3.0
name:               markovian-neural-bridge
version:            0.1.0.0
synopsis:
  Checked exact-action support masks for Markovian neural heads

description:
  A structural adapter from exact finite Markovian action layouts and
  availability order to sized masks accepted by markovian-neural.

category:           Math
homepage:           https://github.com/josephjohncox/Markovian
bug-reports:        https://github.com/josephjohncox/Markovian/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Joseph Cox
maintainer:         joseph@codensity.io
copyright:          2024-2026 Joseph Cox
build-type:         Simple
stability:          Experimental
tested-with:        GHC ==9.4.8 || ==9.8.4
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  scripts/check-exact-support-boundary
  test/compile-fail/ExactSupportRoles.hs

source-repository head
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  subdir:   backends/markovian-neural-bridge

library
  exposed-modules:  Markovian.Backend.Neural.Bridge.ExactSupportMask
  hs-source-dirs:   src
  build-depends:
    , base              >=4.17.2.1 && <4.20
    , Markovian         ^>=0.1.0.0
    , markovian-neural  ^>=0.1.0.0

  default-language: GHC2021
  ghc-options:      -Wall

test-suite markovian-neural-bridge-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:
    , base                     >=4.17.2.1 && <4.20
    , Markovian                ^>=0.1.0.0
    , markovian-neural         ^>=0.1.0.0
    , markovian-neural-bridge  ==0.1.0.0

  default-language: GHC2021
  ghc-options:      -Wall
