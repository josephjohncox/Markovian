cabal-version:      3.0
name:               markovian-neural-bridge
version:            0.1.0.0
synopsis:
  Checked exact-action support masks for Markovian neural heads

description:
  A structural adapter from exact finite Markovian action layouts and
  availability order to sized masks accepted by markovian-neural.

category:           Math
license:            BSD-3-Clause
license-file:       LICENSE
author:             Joseph Cox
maintainer:         joseph@codensity.io
build-type:         Simple
extra-source-files:
  scripts/check-exact-support-boundary
  test/compile-fail/ExactSupportRoles.hs

library
  exposed-modules:  Markovian.Backend.Neural.Bridge.ExactSupportMask
  hs-source-dirs:   src
  build-depends:
    , base              >=4.17.2.1 && <4.20
    , Markovian         >=0.1      && <0.2
    , markovian-neural  >=0.1      && <0.2

  default-language: GHC2021
  ghc-options:      -Wall

test-suite markovian-neural-bridge-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:
    , base                     >=4.17.2.1 && <4.20
    , Markovian                >=0.1      && <0.2
    , markovian-neural         >=0.1      && <0.2
    , markovian-neural-bridge

  default-language: GHC2021
  ghc-options:      -Wall
