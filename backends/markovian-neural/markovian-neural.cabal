cabal-version:      3.0
name:               markovian-neural
version:            2026.9.3.0
synopsis:           Framework-independent neural RL references for Markovian
description:
  Checked dense networks, typed parametric reverse circuits, categorical
  information, policy gradients, replay, target networks, and DQN reference
  computations.

category:           Math
homepage:           https://github.com/josephjohncox/Markovian
bug-reports:        https://github.com/josephjohncox/Markovian/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Joseph Cox
maintainer:         joseph@codensity.io
copyright:          2024-2026 Joseph Cox
build-type:         Simple
stability:          Experimental
tested-with:        GHC ==9.4.8 || ==9.8.4
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  scripts/check-reverse-program-boundary
  test/compile-fail/ReverseProgramOpacity.hs
  test/compile-fail/ReverseProgramTypes.hs

source-repository head
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  subdir:   backends/markovian-neural

source-repository this
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  tag:      v2026.9.3.0
  subdir:   backends/markovian-neural

flag markovian-integration
  description:
    Build tests that compare against the sibling Markovian package

  default:     False
  manual:      True

library
  exposed-modules:
    Markovian.Backend.Neural
    Markovian.Backend.Neural.ActorCritic
    Markovian.Backend.Neural.Approximation
    Markovian.Backend.Neural.Categorical
    Markovian.Backend.Neural.Dense
    Markovian.Backend.Neural.DQN
    Markovian.Backend.Neural.Information
    Markovian.Backend.Neural.Mask
    Markovian.Backend.Neural.Numeric
    Markovian.Backend.Neural.Optimizer
    Markovian.Backend.Neural.Policy
    Markovian.Backend.Neural.Reinforce
    Markovian.Backend.Neural.Replay
    Markovian.Backend.Neural.TargetNetwork
    Markovian.Backend.Neural.Transition

  hs-source-dirs:   src
  build-depends:
    , base               >=4.17.2.1    && <4.20
    , markovian-reverse  ^>=2026.9.3.0

  default-language: GHC2021
  ghc-options:      -Wall

test-suite markovian-neural-test
  type:             exitcode-stdio-1.0
  main-is:          Main.lhs
  other-modules:
    ActionMask
    ActorCritic
    DenseFiniteDifference
    DQN
    Information
    ParametricReverse
    PolicyGradient
    Reinforce
    ReplayTarget
    ReverseProgram
    TestSupport

  hs-source-dirs:   test
  build-depends:
    , base               >=4.17.2.1    && <4.20
    , markovian-neural   ==2026.9.3.0
    , markovian-reverse  ^>=2026.9.3.0

  default-language: GHC2021
  ghc-options:      -Wall

test-suite markovian-neural-integration-test
  type:             exitcode-stdio-1.0
  main-is:          IntegrationMain.hs
  hs-source-dirs:   test
  default-language: GHC2021
  ghc-options:      -Wall

  if !flag(markovian-integration)
    buildable: False

  else
    other-modules:
      MarkovianDifferential
      TestSupport

    build-depends:
      , base                 >=4.17.2.1    && <4.20
      , Markovian            ^>=2026.9.3.0
      , markovian-learning   ^>=2026.9.3.0
      , markovian-neural     ==2026.9.3.0
      , markovian-numerical  ^>=2026.9.3.0
