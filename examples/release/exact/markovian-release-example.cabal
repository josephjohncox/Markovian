cabal-version: 3.4
name:          markovian-release-example
version:       0.0.0.0
build-type:    Simple

executable markovian-release-example
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , base       >=4.17.2.1    && <4.20
    , Markovian  ^>=2026.9.3.0

  default-language: GHC2021
  ghc-options:      -Wall -Werror
