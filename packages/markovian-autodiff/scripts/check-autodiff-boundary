#!/usr/bin/env bash
set -euo pipefail

package_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${package_dir}"

check_failure() {
  local fixture="$1"
  shift
  local log_file
  log_file="$(mktemp)"
  if cabal exec -- ghc -hide-all-packages -fno-code -fmax-errors=100 -package base -package markovian-autodiff "${fixture}" >"${log_file}" 2>&1; then
    rm -f "${log_file}"
    echo "Autodiff boundary fixture unexpectedly compiled: ${fixture}" >&2
    exit 1
  fi
  for expected in "$@"; do
    if ! grep -F "${expected}" "${log_file}" >/dev/null; then
      cat "${log_file}" >&2
      rm -f "${log_file}"
      echo "Expected autodiff rejection was absent: ${expected}" >&2
      exit 1
    fi
  done
  rm -f "${log_file}"
}

check_failure test/compile-fail/AutodiffOpacity.hs \
  badProgramConstructor badTapeConstructor badValueConstructor \
  'not in scope' 'Illegal term-level use'

check_failure test/compile-fail/AutodiffHiddenModule.hs \
  Markovian.Autodiff.Internal.Syntax hidden

check_failure test/compile-fail/AutodiffTypes.hs \
  badIntermediateTypes badExactSmooth badOwnerSharing badScalarVectorCoercion \
  "Couldn't match type"

check_failure test/compile-fail/AutodiffOwnerCoercion.hs \
  badOwnerCoercion "Couldn't match type"

check_failure test/compile-fail/AutodiffEndpoints.hs \
  badWrongSeed badWrongFragment badWrongTree badCrossEndpoint \
  "Couldn't match type"

echo "PASS: autodiff syntax, values, tapes, shapes, owners, fragments, and endpoints remain protected"
