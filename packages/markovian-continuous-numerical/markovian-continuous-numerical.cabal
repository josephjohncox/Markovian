cabal-version:      3.4
name:               markovian-continuous-numerical
version:            2026.9.3.0
synopsis:           Bounded numerical continuous probability for Markovian
description:
  Explicit exact-to-Double conversion, deterministic bounded GK15/7
  quadrature, SplitMix64-owned sampling, named one-dimensional laws, and
  resumable Welford Monte Carlo reports. Estimated errors are not certified
  bounds.

category:           Math
homepage:           https://github.com/josephjohncox/Markovian
bug-reports:        https://github.com/josephjohncox/Markovian/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Joseph Cox
maintainer:         joseph@codensity.io
copyright:          2024-2026 Joseph Cox
build-type:         Simple
stability:          Experimental
tested-with:        GHC ==9.4.8 || ==9.8.4
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  scripts/check-continuous-numerical-boundary
  test/compile-fail/NumericalBoundary.hs

source-repository head
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  subdir:   packages/markovian-continuous-numerical

source-repository this
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  tag:      v2026.9.3.0
  subdir:   packages/markovian-continuous-numerical

common warnings
  ghc-options: -Wall

library
  import:             warnings
  exposed-modules:
    Markovian.Continuous.Numerical.Generator
    Markovian.Continuous.Numerical.MonteCarlo
    Markovian.Continuous.Numerical.Quadrature
    Markovian.Continuous.Numerical.Value

  hs-source-dirs:     src
  build-depends:      base >=4.17.2.1 && <4.20
  default-language:   GHC2021
  default-extensions: DerivingStrategies

test-suite markovian-continuous-numerical-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:
    , base                            >=4.17.2.1    && <4.20
    , markovian-continuous            ^>=2026.9.3.0
    , markovian-continuous-numerical  ==2026.9.3.0

  default-language: GHC2021

benchmark markovian-continuous-numerical-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   bench
  build-depends:
    , base                            >=4.17.2.1   && <4.20
    , markovian-continuous-numerical  ==2026.9.3.0

  default-language: GHC2021
