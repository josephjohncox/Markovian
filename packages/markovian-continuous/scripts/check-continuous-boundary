#!/usr/bin/env bash
set -euo pipefail
log_file="$(mktemp)"
trap 'rm -f "${log_file}"' EXIT
project_args=()
if [[ -f cabal.project && -f cabal.project.ci ]]; then
  project_args+=(--project-file=cabal.project.ci)
fi
fixture="packages/markovian-continuous/test/compile-fail/ContinuousBoundary.hs"
[[ -f "${fixture}" ]] || fixture="test/compile-fail/ContinuousBoundary.hs"
if cabal exec "${project_args[@]}" -- ghc -fno-code -package markovian-continuous "${fixture}" >"${log_file}" 2>&1; then
  echo "Continuous constructors, roles, or unsupported conditioning escaped." >&2
  exit 1
fi
for rejected in badLawConstructor badKernelConstructor badPosteriorConstructor badOwnerCoerce badLawCoerce badArbitraryDensity badConditionPoint badGeneralDisintegrate; do
  grep -F "${rejected}" "${log_file}" >/dev/null || { cat "${log_file}" >&2; echo "Missing ${rejected} boundary error." >&2; exit 1; }
done
echo "PASS: continuous opacity, nominal roles, and conditioning boundary"
