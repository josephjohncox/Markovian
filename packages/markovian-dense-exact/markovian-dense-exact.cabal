cabal-version:   3.4
name:            markovian-dense-exact
version:         2026.9.3.0
synopsis:        Optional dense Rational execution for Markovian
description:
  Dense row-major Rational storage and execution lowered from the supported
  exact circuit semantics. The superseded finite IR is private regression code.

category:        Math
homepage:        https://github.com/josephjohncox/Markovian
bug-reports:     https://github.com/josephjohncox/Markovian/issues
license:         BSD-3-Clause
license-file:    LICENSE
author:          Joseph Cox
maintainer:      joseph@codensity.io
copyright:       2024-2026 Joseph Cox
build-type:      Simple
stability:       Experimental
tested-with:     GHC ==9.4.8 || ==9.8.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  subdir:   packages/markovian-dense-exact

source-repository this
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  tag:      v2026.9.3.0
  subdir:   packages/markovian-dense-exact

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:  Markovian.Backend.CPU.Exact
  hs-source-dirs:   src
  build-depends:
    , base       >=4.17.2.1    && <4.20
    , Markovian  ^>=2026.9.3.0

  default-language: GHC2021

library legacy-finite-ir
  import:           warnings
  visibility:       private
  exposed-modules:  Markovian.DenseExact.Internal.LegacyFiniteIR
  hs-source-dirs:   legacy
  build-depends:
    , base       >=4.17.2.1    && <4.20
    , Markovian  ^>=2026.9.3.0

  default-language: GHC2021

test-suite markovian-dense-exact-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  other-modules:    StochasticCircuit
  hs-source-dirs:   test
  build-depends:
    , base                                    >=4.17.2.1    && <4.20
    , Markovian                               ^>=2026.9.3.0
    , markovian-dense-exact                   ==2026.9.3.0
    , markovian-dense-exact:legacy-finite-ir
    , markovian-numerical                     ^>=2026.9.3.0

  default-language: GHC2021
