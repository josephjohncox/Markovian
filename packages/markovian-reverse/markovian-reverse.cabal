cabal-version:      3.0
name:               markovian-reverse
version:            2026.9.3.0
synopsis:           Bounded typed reverse-program core for Markovian
description:
  Backend-independent finite reverse circuits and bounded owned reverse
  programs. Primitive authors supply pullbacks and their laws; this package
  does not differentiate arbitrary Haskell.

category:           Math
homepage:           https://github.com/josephjohncox/Markovian
bug-reports:        https://github.com/josephjohncox/Markovian/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Joseph Cox
maintainer:         joseph@codensity.io
copyright:          2024-2026 Joseph Cox
build-type:         Simple
stability:          Experimental
tested-with:        GHC ==9.4.8 || ==9.8.4
extra-doc-files:
  CHANGELOG.md
  README.md

extra-source-files:
  scripts/check-reverse-boundary
  test/compile-fail/EffectEndpoints.hs
  test/compile-fail/EffectOpacity.hs
  test/Main.hs

source-repository head
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  subdir:   packages/markovian-reverse

source-repository this
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  tag:      v2026.9.3.0
  subdir:   packages/markovian-reverse

library
  exposed-modules:
    Markovian.Reverse
    Markovian.Reverse.Program
    Markovian.Reverse.Program.Effect

  other-modules:    Markovian.Reverse.Program.Internal
  hs-source-dirs:   src
  build-depends:    base >=4.17.2.1 && <4.20
  default-language: GHC2021
  ghc-options:      -Wall

test-suite markovian-reverse-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:    Effect
  build-depends:
    , base               >=4.17.2.1   && <4.20
    , markovian-reverse  ==2026.9.3.0

  default-language: GHC2021
  ghc-options:      -Wall
