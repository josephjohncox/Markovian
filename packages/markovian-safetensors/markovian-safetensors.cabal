cabal-version:      3.4
name:               markovian-safetensors
version:            2026.9.3.0
synopsis:           Bounded canonical F64 SafeTensors profile for Markovian
description:
  A duplicate-preserving bounded parser and deterministic encoder for the
  canonical metadata-free F64 subset of the SafeTensors format pinned at
  revision 6eb4dc9a28ebce297606e0f4836bbf28839cacef.

category:           Math
homepage:           https://github.com/josephjohncox/Markovian
bug-reports:        https://github.com/josephjohncox/Markovian/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Joseph Cox
maintainer:         joseph@codensity.io
copyright:          2024-2026 Joseph Cox
build-type:         Simple
stability:          Experimental
tested-with:        GHC ==9.4.8 || ==9.8.4
extra-doc-files:
  CHANGELOG.md
  README.md

data-files:         test/golden/canonical-f64.hex
extra-source-files:
  scripts/check-safetensors-boundary
  test/compile-fail/SafeTensorOpacity.hs
  test/compile-fail/SafeTensorRegionEscape.hs

source-repository head
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  subdir:   packages/markovian-safetensors

source-repository this
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  tag:      v2026.9.3.0
  subdir:   packages/markovian-safetensors

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:  Markovian.Tensor.SafeTensors
  hs-source-dirs:   src
  build-depends:
    , base              >=4.17.2.1    && <4.20
    , bytestring        >=0.11        && <0.13
    , markovian-tensor  ^>=2026.9.3.0

  default-language: GHC2021

test-suite markovian-safetensors-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:    Paths_markovian_safetensors
  autogen-modules:  Paths_markovian_safetensors
  build-depends:
    , base                   >=4.17.2.1   && <4.20
    , bytestring             >=0.11       && <0.13
    , markovian-safetensors  ==2026.9.3.0
    , markovian-tensor       ==2026.9.3.0

  default-language: GHC2021
