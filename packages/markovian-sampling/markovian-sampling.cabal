cabal-version:   3.4
name:            markovian-sampling
version:         2026.9.3.0
synopsis:        Explicit sampled interpreters for Markovian
description:
  Deterministic explicit generators and bounded sampled interpreters for
  finite floating and exact distributions.

category:        Math
homepage:        https://github.com/josephjohncox/Markovian
bug-reports:     https://github.com/josephjohncox/Markovian/issues
license:         BSD-3-Clause
license-file:    LICENSE
author:          Joseph Cox
maintainer:      joseph@codensity.io
copyright:       2024-2026 Joseph Cox
build-type:      Simple
stability:       Experimental
tested-with:     GHC ==9.4.8 || ==9.8.4
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  subdir:   packages/markovian-sampling

source-repository this
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  tag:      v2026.9.3.0
  subdir:   packages/markovian-sampling

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:
    Markovian.Interpreter.Sampled
    Markovian.Interpreter.Sampled.Step
    Markovian.Sampling

  hs-source-dirs:   src
  build-depends:
    , base                 >=4.17.2.1    && <4.20
    , Markovian            ^>=2026.9.3.0
    , markovian-numerical  ^>=2026.9.3.0

  default-language: GHC2021

test-suite markovian-sampling-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:
    , base                 >=4.17.2.1    && <4.20
    , markovian-numerical  ^>=2026.9.3.0
    , markovian-sampling   ==2026.9.3.0

  default-language: GHC2021
