cabal-version:      3.4
name:               markovian-tensor
version:            2026.9.3.0
synopsis:           Checked host F64 tensor runtime for Markovian
description:
  A bounded host-only F64 buffer runtime with typed shapes, checked immutable
  layouts, deterministic CPU primitives, explicit semantic ownership, and
  closed primitive reverse tapes. It does not claim general tensor semantics
  or device correctness.

category:           Math
homepage:           https://github.com/josephjohncox/Markovian
bug-reports:        https://github.com/josephjohncox/Markovian/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             Joseph Cox
maintainer:         joseph@codensity.io
copyright:          2024-2026 Joseph Cox
build-type:         Simple
stability:          Experimental
tested-with:        GHC ==9.4.8 || ==9.8.4
extra-doc-files:
  CHANGELOG.md
  README.md

data-files:         test/golden/add-report.txt
extra-source-files:
  scripts/check-tensor-boundary
  test/compile-fail/TensorBoundary.hs
  test/compile-fail/TensorRegionEscape.hs

source-repository head
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  subdir:   packages/markovian-tensor

source-repository this
  type:     git
  location: https://github.com/josephjohncox/Markovian.git
  tag:      v2026.9.3.0
  subdir:   packages/markovian-tensor

common warnings
  ghc-options: -Wall

library
  import:           warnings
  exposed-modules:
    Markovian.Tensor
    Markovian.Tensor.Ownership
    Markovian.Tensor.Primitive
    Markovian.Tensor.Reverse
    Markovian.Tensor.Shape

  other-modules:
    Markovian.Tensor.Internal
    Markovian.Tensor.Internal.Reverse

  hs-source-dirs:   src
  build-depends:    base >=4.17.2.1 && <4.20
  default-language: GHC2021

test-suite markovian-tensor-fault-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test-fault src
  other-modules:
    Markovian.Tensor.Internal
    Markovian.Tensor.Shape

  build-depends:    base >=4.17.2.1 && <4.20
  default-language: GHC2021

test-suite markovian-tensor-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:    Paths_markovian_tensor
  autogen-modules:  Paths_markovian_tensor
  build-depends:
    , base              >=4.17.2.1   && <4.20
    , markovian-tensor  ==2026.9.3.0

  default-language: GHC2021

benchmark markovian-tensor-bench
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   bench
  build-depends:
    , base              >=4.17.2.1   && <4.20
    , markovian-tensor  ==2026.9.3.0

  default-language: GHC2021
