#!/usr/bin/env bash
set -euo pipefail

package_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${package_dir}"

check_failure() {
  local fixture="$1"
  shift
  local log_file
  log_file="$(mktemp)"
  if cabal exec -- ghc -fno-code -fmax-errors=100 -package markovian-tensor "${fixture}" >"${log_file}" 2>&1; then
    rm -f "${log_file}"
    echo "Tensor boundary fixture unexpectedly compiled: ${fixture}" >&2
    exit 1
  fi
  for expected in "$@"; do
    if ! grep -F "${expected}" "${log_file}" >/dev/null; then
      cat "${log_file}" >&2
      rm -f "${log_file}"
      echo "Expected tensor rejection was absent: ${expected}" >&2
      exit 1
    fi
  done
  rm -f "${log_file}"
}

check_failure test/compile-fail/TensorBoundary.hs \
  badHostConstructor badDynamicConstructor badFiniteConstructor badLayoutConstructor \
  badStorageConstructor badOwnerConstructor

check_failure test/compile-fail/TensorRegionEscape.hs \
  badRegionEscape badShapeCoercion badStorageRegionCoercion \
  badOwnerCoercion badMatmulInnerDimensions \
  "Couldn't match type"

echo "PASS: tensor buffers, layouts, storage IDs, owners, and regions remain protected"
