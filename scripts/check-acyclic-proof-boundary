#!/usr/bin/env bash
set -euo pipefail

log_file="$(mktemp)"
trap 'rm -f "${log_file}"' EXIT

project_args=()
if [[ -f cabal.project && -f cabal.project.ci ]]; then
  project_args+=(--project-file=cabal.project.ci)
fi

if cabal exec "${project_args[@]}" -- ghc \
  -fno-code \
  -package Markovian \
  test/compile-fail/AcyclicProofBoundary.hs >"${log_file}" 2>&1; then
  echo "The acyclic open-system proof boundary was bypassed." >&2
  exit 1
fi

for rejected_identifier in \
  badRawInterpreter \
  badConstructor \
  badForgeCycle \
  badReverseObserver \
  badGlobalDecoration; do
  if ! grep -F "${rejected_identifier}" "${log_file}" >/dev/null; then
    cat "${log_file}" >&2
    echo "The expected ${rejected_identifier} rejection was absent." >&2
    exit 1
  fi
done

if ! grep -E "not in scope|Couldn't match" "${log_file}" >/dev/null; then
  cat "${log_file}" >&2
  echo "The fixture failed outside the intended refinement boundary." >&2
  exit 1
fi

echo "PASS: raw, forged, reversed, and globally decorated open systems cannot use the DAG interpreter"
