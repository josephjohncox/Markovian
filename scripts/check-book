#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../toolchain.env
source "$project_root/toolchain.env"

export PATH="$project_root/.direnv/bin:$PATH"
expected="mdbook v${MARKOVIAN_MDBOOK_VERSION}"

if ! command -v mdbook >/dev/null 2>&1; then
  echo "$expected is not installed. Run scripts/install-doc-tools." >&2
  exit 1
fi

actual="$(mdbook --version)"
if [[ "$actual" != "$expected" ]]; then
  echo "Expected $expected but found $actual." >&2
  exit 1
fi

python3 "$project_root/scripts/check-book-links" "$project_root/docs/book/src"

mathjax="$project_root/docs/book/theme/vendor/mathjax/tex-svg-full.js"
test -f "$mathjax"
actual_mathjax_sha256="$(sha256sum "$mathjax" | cut -d ' ' -f 1)"
if [[ "$actual_mathjax_sha256" != "$MARKOVIAN_MATHJAX_SHA256" ]]; then
  echo "Expected MathJax $MARKOVIAN_MATHJAX_VERSION SHA-256 $MARKOVIAN_MATHJAX_SHA256 but found $actual_mathjax_sha256." >&2
  exit 1
fi

rm -rf "$project_root/docs/book/build"
mdbook build "$project_root/docs/book"
test -f "$project_root/docs/book/build/index.html"
grep -Fq 'theme/mathjax-config-' "$project_root/docs/book/build/index.html"
grep -Fq 'theme/vendor/mathjax/tex-svg-full-' "$project_root/docs/book/build/index.html"
grep -Fq 'restoreMarkdownMath' "$project_root/docs/book/build/theme/mathjax-config-"*.js
if grep -RFq 'cdnjs.cloudflare.com/ajax/libs/mathjax' "$project_root/docs/book/build"; then
  echo "The generated book still depends on external MathJax." >&2
  exit 1
fi

python3 - "$project_root/docs/book/src" "$project_root/docs/book/build" <<'PY'
from pathlib import Path
import html
import re
import sys

source = Path(sys.argv[1])
build = Path(sys.argv[2])


def source_display_blocks(text: str) -> int:
    count = 0
    fence_character = None
    fence_length = 0
    for line in text.splitlines():
        stripped = line.lstrip()
        fence = re.match(r"^(`{3,}|~{3,})", stripped)
        if fence_character is not None:
            if fence and fence.group(1)[0] == fence_character and len(fence.group(1)) >= fence_length:
                fence_character = None
                fence_length = 0
            continue
        if fence:
            fence_character = fence.group(1)[0]
            fence_length = len(fence.group(1))
            continue
        if line.strip() == r"\\[":
            count += 1
    return count


checked = 0
for chapter in source.glob("*.md"):
    output = build / f"{chapter.stem}.html"
    if not output.is_file():
        continue
    expected_blocks = source_display_blocks(chapter.read_text(encoding="utf-8"))
    generated = output.read_text(encoding="utf-8")
    rendered = re.findall(r"<p>\\\[(.*?)\\\]</p>", generated, flags=re.DOTALL)
    if len(rendered) != expected_blocks:
        raise SystemExit(
            f"{chapter.name}: expected {expected_blocks} display-math blocks in generated HTML but found {len(rendered)}"
        )
    for index, block in enumerate(rendered, start=1):
        tags = set(re.findall(r"</?([A-Za-z][A-Za-z0-9-]*)\b", block))
        unsupported_tags = tags - {"em", "strong"}
        if unsupported_tags:
            raise SystemExit(
                f"{chapter.name}: display-math block {index} contains unsupported Markdown HTML tags "
                f"{sorted(unsupported_tags)}"
            )
        recovered = re.sub(r"<em>", "_", block)
        recovered = re.sub(r"</em>", "_", recovered)
        recovered = re.sub(r"<strong>", "**", recovered)
        recovered = re.sub(r"</strong>", "**", recovered)
        recovered = html.unescape(recovered).replace("’", "'")
        if re.search(r"</?[A-Za-z][^>]*>", recovered):
            raise SystemExit(
                f"{chapter.name}: display-math block {index} was not fully recovered from Markdown markup"
            )
    checked += expected_blocks
if checked == 0:
    raise SystemExit("No display-math blocks were checked.")
print(f"Checked {checked} display-math blocks against generated chapter HTML.")
PY

echo "Checked $expected with local MathJax $MARKOVIAN_MATHJAX_VERSION at docs/book/build/index.html"
