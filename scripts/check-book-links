#!/usr/bin/env python3
"""Check local Markdown links, anchors, includes, and math delimiters."""

from __future__ import annotations

import re
import sys
from pathlib import Path
from urllib.parse import unquote, urlparse

LINK = re.compile(r"(?<!!)\[[^\]]*\]\(([^)]+)\)")
INCLUDE = re.compile(r"\{\{#include\s+([^}\s:]+)(?::[^}\s]+)?\}\}")
HEADING = re.compile(r"^#{1,6}\s+(.+?)\s*#*\s*$")
FENCE = re.compile(r"^(`{3,}|~{3,})")
MARKDOWN_SENSITIVE_TEX = re.compile(r"(?<!\\)\\[!,:;{}_%#&$]")
BARE_TEX_STAR = re.compile(r"\*")


def slug(text: str) -> str:
    value = text.strip().lower()
    value = re.sub(r"[`*_]", "", value)
    value = re.sub(r"[^\w\-\s]", "", value, flags=re.UNICODE)
    return re.sub(r"[\s]+", "-", value)


def anchors(path: Path) -> set[str]:
    found: set[str] = set()
    counts: dict[str, int] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        match = HEADING.match(line)
        if match is None:
            continue
        base = slug(match.group(1))
        count = counts.get(base, 0)
        counts[base] = count + 1
        found.add(base if count == 0 else f"{base}-{count}")
    return found


def local_target(raw: str) -> tuple[str, str] | None:
    target = raw.strip()
    if target.startswith("<") and target.endswith(">"):
        target = target[1:-1]
    target = target.split(maxsplit=1)[0]
    parsed = urlparse(target)
    if parsed.scheme or parsed.netloc:
        return None
    return unquote(parsed.path), unquote(parsed.fragment)


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: check-book-links BOOK_SOURCE", file=sys.stderr)
        return 2

    source = Path(sys.argv[1]).resolve()
    failures: list[str] = []
    markdown_files = sorted(source.rglob("*.md"))

    if not markdown_files:
        failures.append(f"no Markdown files found under {source}")

    for document in markdown_files:
        text = document.read_text(encoding="utf-8")
        math_opens = 0
        math_closes = 0
        in_display_math = False
        fence_character: str | None = None
        fence_length = 0
        for line_number, line in enumerate(text.splitlines(), start=1):
            stripped = line.strip()
            fence = FENCE.match(line.lstrip())
            if fence_character is not None:
                if (
                    fence is not None
                    and fence.group(1)[0] == fence_character
                    and len(fence.group(1)) >= fence_length
                ):
                    fence_character = None
                    fence_length = 0
                continue
            if fence is not None:
                fence_character = fence.group(1)[0]
                fence_length = len(fence.group(1))
                continue
            if stripped == r"\[" or stripped == r"\]":
                failures.append(
                    f"{document}:{line_number}: mdBook math delimiter needs two backslashes"
                )
            elif stripped == r"\\[":
                math_opens += 1
                in_display_math = True
            elif stripped == r"\\]":
                math_closes += 1
                in_display_math = False
            elif in_display_math and MARKDOWN_SENSITIVE_TEX.search(line):
                failures.append(
                    f"{document}:{line_number}: TeX punctuation command needs two backslashes before Markdown rendering"
                )
            elif in_display_math and BARE_TEX_STAR.search(line):
                failures.append(
                    f"{document}:{line_number}: use \\star or \\ast instead of a bare TeX asterisk that Markdown can treat as emphasis"
                )
            if in_display_math:
                continue
            for match in LINK.finditer(line):
                parsed = local_target(match.group(1))
                if parsed is None:
                    continue
                relative, fragment = parsed
                target = document if relative == "" else (document.parent / relative).resolve()
                if not target.exists():
                    failures.append(
                        f"{document}:{line_number}: missing link target {relative!r}"
                    )
                    continue
                if fragment and target.suffix.lower() == ".md":
                    if fragment not in anchors(target):
                        failures.append(
                            f"{document}:{line_number}: missing anchor {fragment!r} in {target}"
                        )
            for match in INCLUDE.finditer(line):
                target = (document.parent / match.group(1)).resolve()
                if not target.is_file():
                    failures.append(
                        f"{document}:{line_number}: missing include target {match.group(1)!r}"
                    )
        if math_opens != math_closes:
            failures.append(
                f"{document}: unbalanced mdBook display math delimiters "
                f"({math_opens} open, {math_closes} close)"
            )

    if failures:
        print("Book link check failed:", file=sys.stderr)
        for failure in failures:
            print(f"- {failure}", file=sys.stderr)
        return 1

    print(
        "Checked local links, includes, and math delimiters in "
        f"{len(markdown_files)} book files."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
