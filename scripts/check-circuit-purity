#!/usr/bin/env bash
set -euo pipefail

log_file="$(mktemp)"
trap 'rm -f "${log_file}"' EXIT

project_args=()
if [[ -f cabal.project && -f cabal.project.ci ]]; then
  project_args+=(--project-file=cabal.project.ci)
fi

if cabal exec "${project_args[@]}" -- ghc \
  -fno-code \
  -package Markovian \
  test/compile-fail/CircuitPurity.hs >"${log_file}" 2>&1; then
  echo "Stochastic syntax was accepted by deterministic-only circuit APIs." >&2
  exit 1
fi

for rejected_operation in \
  badCopyRewrite \
  badStrengthen \
  badPurityCoerce \
  badDeduplicationCertificate \
  badDiracStochasticCertificate \
  badEndpointCoerce \
  UnsafeDeterministicRewrite \
  UnsafeCheckedDeterministicRewrite; do
  if ! grep -F "${rejected_operation}" "${log_file}" >/dev/null; then
    cat "${log_file}" >&2
    echo "The expected ${rejected_operation} purity error was absent." >&2
    exit 1
  fi
done

if ! grep -F "Couldn't match type" "${log_file}" >/dev/null; then
  cat "${log_file}" >&2
  echo "The fixture failed for a reason other than circuit purity." >&2
  exit 1
fi

echo "PASS: circuit purity, endpoint roles, and rewrite-certificate opacity"
