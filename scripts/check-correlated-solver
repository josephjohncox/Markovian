#!/usr/bin/env bash
# Check solver opacity, nominal roles, and the private CE/CCE fixtures.
# Private probes compile from source; the library keeps the core hidden.
set -euo pipefail

project_args=()
if [[ -f cabal.project && -f cabal.project.ci ]]; then
  project_args+=(--project-file=cabal.project.ci)
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "${tmp_dir}"' EXIT

# One compile-fail control. Requires rejection, then requires each named
# expected error text to be present in that control's own log.
compile_failure() {
  local fixture="$1"
  local log_file="$2"
  shift 2
  if cabal exec "${project_args[@]}" -- ghc \
    -package-env - -hide-all-packages -package base -isrc -XGHC2021 \
    -fno-code -fmax-errors=200 -outputdir "${tmp_dir}/cf" \
    "${fixture}" >"${log_file}" 2>&1; then
    echo "The solver boundary fixture ${fixture} was accepted." >&2
    exit 1
  fi
  local expected
  for expected in "$@"; do
    if ! grep -F "${expected}" "${log_file}" >/dev/null; then
      cat "${log_file}" >&2
      echo "The expected ${expected} boundary error was absent from ${fixture}." >&2
      exit 1
    fi
  done
}

# §11.8 solution construction: hidden positional constructors.
compile_failure test/compile-fail/CorrelatedSolverConstruction.hs \
  "${tmp_dir}/construction.log" \
  badCorrelatedSolutionConstructor \
  badCoarseSolutionConstructor \
  badSolveLimitsConstructor \
  badSolveAccountingConstructor \
  'Illegal term-level use of the type constructor'
echo "PASS: D083 solution, limits and accounting constructors are opaque"

# §11.8 record update: accessors are functions, not record selectors. GHC stops
# at the first out-of-scope record field, so each field gets its own module.
for field in correlatedSolutionDevice coarseCorrelatedSolutionDevice \
  correlationSolveCandidates maximumCorrelationSolveCandidates; do
  case "${field}" in
    correlatedSolutionDevice) subject='CorrelatedEquilibriumSolution owner action' ;;
    coarseCorrelatedSolutionDevice) subject='CoarseCorrelatedEquilibriumSolution owner action' ;;
    correlationSolveCandidates) subject='CorrelationSolveAccounting' ;;
    maximumCorrelationSolveCandidates) subject='CorrelationSolveLimits' ;;
    *)
      echo "unknown solver update field: ${field}" >&2
      exit 1
      ;;
  esac
  fixture="${tmp_dir}/SolverUpdate_${field}.hs"
  {
    printf 'module SolverUpdate_%s where\n' "${field}"
    printf 'import Markovian.Game.Correlated.Exact\n'
    printf 'badUpdate :: %s -> %s\n' "${subject}" "${subject}"
    printf 'badUpdate x = x{%s = undefined}\n' "${field}"
  } >"${fixture}"
  compile_failure "${fixture}" "${tmp_dir}/update-${field}.log" \
    "Not in scope: record field" "${field}"
done

echo "PASS: D083 solution and accounting accessors reject record update"

# §11.8 owner/action coercion: nominal roles on both parameters.
compile_failure test/compile-fail/CorrelatedSolverCoercion.hs \
  "${tmp_dir}/coercion.log" \
  badCorrelatedSolutionOwnerCoerce \
  badCorrelatedSolutionActionCoerce \
  badCoarseSolutionOwnerCoerce \
  badCoarseSolutionActionCoerce \
  badSolveErrorOwnerCoerce \
  badSolveErrorActionCoerce \
  "Couldn't match type"
echo "PASS: D083 solution and error owner/action roles are nominal"

# §11.8 CE/CCE interchange: the two solution types are distinct.
compile_failure test/compile-fail/CorrelatedSolverInterchange.hs \
  "${tmp_dir}/interchange.log" \
  badSolutionInterchange \
  badCoarseSolutionInterchange \
  badSolutionInterchangeCoerce \
  badCoarseAccessorOnCorrelated \
  badCorrelatedAccessorOnCoarse \
  badReportInterchange \
  "Couldn't match type"
echo "PASS: D083 CE and CCE solutions are not interchangeable"

# Check the builder, elimination, geometry gates and verification shadow at
# both optimization levels required by the solver contract.
for optimization in 0 2; do
  cabal exec "${project_args[@]}" -- ghc \
    -package-env - -hide-all-packages -package base -isrc -XGHC2021 \
    "-O${optimization}" -Wall -Werror \
    -outputdir "${tmp_dir}/private-O${optimization}" \
    test/CorrelatedSolverPrivate.hs \
    -o "${tmp_dir}/correlated-solver-private-O${optimization}"
  "${tmp_dir}/correlated-solver-private-O${optimization}"
  echo "PASS: D083 private builder, elimination, geometry and shadow controls at O${optimization}"
  cabal exec "${project_args[@]}" -- ghc \
    -package-env - -hide-all-packages -package base -isrc -XGHC2021 \
    "-O${optimization}" -Wall -Werror \
    -outputdir "${tmp_dir}/geometry-O${optimization}" \
    test/CorrelatedSolverGeometry.hs \
    -o "${tmp_dir}/geometry-O${optimization}-probe"
  "${tmp_dir}/geometry-O${optimization}-probe"
  echo "PASS: D083 complete tiny geometry and independent ledger at O${optimization}"
done

# Observe source-level ordering in scratch copies, leaving the library and its
# public API unchanged. These events are deliberately attached to evaluation,
# not inferred from the final error or the successful accounting report.
python3 - "${tmp_dir}/instrumented" "${tmp_dir}/infeasible" <<'PY'
from pathlib import Path
import sys

destination = Path(sys.argv[1])

def replace_once(source, old, new):
    if source.count(old) != 1:
        raise SystemExit(f"solver instrumentation site changed: {old!r}")
    return source.replace(old, new)

for relative in ["Markovian/Game/Correlated/Exact/Internal.hs", "Markovian/Game/Correlated/Exact.hs"]:
    source = (Path("src") / relative).read_text()
    source = replace_once(source, "import Data.List.NonEmpty qualified as NonEmpty", "import Data.List.NonEmpty qualified as NonEmpty\nimport Debug.Trace (trace)")
    if relative.endswith("Internal.hs"):
        source = replace_once(source, "pure (result : results)", 'pure (trace "SOLVER_RESULT_LIST_CONS" (result : results))')
        source = replace_once(source, "carrierValues = NonEmpty.toList . finiteObjectValues", 'carrierValues carrier = trace "SOLVER_CARRIER_INSPECTION" (NonEmpty.toList (finiteObjectValues carrier))')
        source = replace_once(source, "case finiteObjectValues values of", 'case trace "SOLVER_BORROWED_CARRIER_INSPECTION" (finiteObjectValues values) of')
        source = replace_once(source, "candidateMatrix limits dimension constraints selected = do", 'candidateMatrix limits dimension constraints selected = trace "SOLVER_CANDIDATE_MATRIX" $ do')
        source = replace_once(source, "eliminate limits dimension variables matrix = go matrix 0 0 0", 'eliminate limits dimension variables matrix = trace "SOLVER_ELIMINATION" $ go matrix 0 0 0')
        source = replace_once(source, "successorTuple bound indices = scan (reverseList indices []) 0", 'successorTuple bound indices = trace "SOLVER_SUCCESSOR" $ scan (reverseList indices []) 0')
        for name in ["correlatedShadow", "coarseShadow"]:
            source = replace_once(source, f"{name} limits game entries labels = do", f'{name} limits game entries labels = trace "SOLVER_SHADOW" $ do')
    else:
        source = replace_once(source, "exactCorrelationDevice limits product_ supplied = do", 'exactCorrelationDevice limits product_ supplied = trace "SOLVER_DEVICE" $ do')
        for name in ["checkCorrelatedEquilibrium", "checkCoarseCorrelatedEquilibrium"]:
            header = f"{name} limits game device@(ExactCorrelationDevice product_ _)\n"
            source = replace_once(source, header, header + '    | trace "SOLVER_CHECKER" False = Left CorrelatedInternalLayoutMismatch\n')
        for name in ["agreesWithCorrelatedShadow limits game device shadow report", "agreesWithCoarseShadow limits device shadow report"]:
            source = replace_once(source, name + "\n", name + '\n    | trace "SOLVER_REPORT_COMPARISON" False = disagreement\n')
    target = destination / relative
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(source)

# Retain the actual admission, geometry, builder and search loop. Only its
# private stream input is replaced by the frozen infeasible linear system.
# The dimension is 1 owner + 2 local actions + 2 variables + 3 rows + 1.
# This source is compiled separately and never installed or exported.
relative = "Markovian/Game/Correlated/Exact.hs"
source = (destination / relative).read_text()
source = replace_once(source,
    "    stream constraints constraintDimension profiles rows",
    "    stream (take 2 constraints ++ [Internal.ConstraintRow (Internal.NonnegativityRow 2) [-1,-1]]) 9 2 3")
target = Path(sys.argv[2]) / relative
target.parent.mkdir(parents=True, exist_ok=True)
target.write_text(source)
PY

check_event_count() {
  local event="$1"
  local expected="$2"
  local log_file="$3"
  local observed
  observed="$(grep -Fc "${event}" "${log_file}" || true)"
  if [[ "${observed}" != "${expected}" ]]; then
    cat "${log_file}" >&2
    echo "Expected ${expected} ${event} events; observed ${observed}." >&2
    exit 1
  fi
}

for optimization in 0 2; do
  cabal exec "${project_args[@]}" -- ghc \
    -package-env - -hide-all-packages -package base \
    "-i${tmp_dir}/instrumented" -isrc -XGHC2021 \
    "-O${optimization}" -Wall -Werror \
    -outputdir "${tmp_dir}/reservation-O${optimization}" \
    test/CorrelatedSolverPrivate.hs \
    -o "${tmp_dir}/reservation-O${optimization}-probe"
  log_file="${tmp_dir}/reservation-events-O${optimization}.log"
  if ! "${tmp_dir}/reservation-O${optimization}-probe" --reservation-events >"${log_file}" 2>&1; then
    cat "${log_file}" >&2
    exit 1
  fi
  for expected in SOLVER_RESULT_LIST_CONS SOLVER_CARRIER_INSPECTION SOLVER_BORROWED_CARRIER_INSPECTION SOLVER_REPORT_COMPARISON; do
    if ! grep -F "${expected}" "${log_file}" >/dev/null; then
      cat "${log_file}" >&2
      echo "The positive reservation control did not observe ${expected}." >&2
      exit 1
    fi
  done
  for control in admission spine publication; do
    case "${control}" in
      admission) forbidden=(SOLVER_RESULT_LIST_CONS SOLVER_CARRIER_INSPECTION) ;;
      spine) forbidden=(SOLVER_CARRIER_INSPECTION SOLVER_BORROWED_CARRIER_INSPECTION) ;;
      publication) forbidden=(SOLVER_REPORT_COMPARISON) ;;
    esac
    log_file="${tmp_dir}/${control}-O${optimization}.log"
    if ! "${tmp_dir}/reservation-O${optimization}-probe" "--${control}-reservation" >"${log_file}" 2>&1; then
      cat "${log_file}" >&2
      exit 1
    fi
    for event in "${forbidden[@]}"; do
      if grep -F "${event}" "${log_file}" >/dev/null; then
        cat "${log_file}" >&2
        echo "The ${control} control evaluated ${event} before its reservation." >&2
        exit 1
      fi
    done
    if [[ "${control}" == admission ]]; then
      check_event_count SOLVER_BORROWED_CARRIER_INSPECTION 10 "${log_file}"
    fi
  done
  echo "PASS: D083 admission and publication reserve before evaluation at O${optimization}"

  # Both modes: cap zero admits no matrix, cap one admits one rejected matrix,
  # and the positive cap-two control admits two matrices and a checked witness.
  for control in positive zero next; do
    case "${control}" in
      positive) expected=4 ;;
      zero) expected=0 ;;
      next) expected=2 ;;
    esac
    log_file="${tmp_dir}/candidate-${control}-O${optimization}.log"
    if ! "${tmp_dir}/reservation-O${optimization}-probe" "--candidate-${control}" >"${log_file}" 2>&1; then
      cat "${log_file}" >&2
      exit 1
    fi
    check_event_count SOLVER_CANDIDATE_MATRIX "${expected}" "${log_file}"
    check_event_count SOLVER_ELIMINATION "${expected}" "${log_file}"
  done
  echo "PASS: D083 candidate caps precede matrix and elimination entry at O${optimization}"

  cabal exec "${project_args[@]}" -- ghc \
    -package-env - -hide-all-packages -package base \
    "-i${tmp_dir}/infeasible" "-i${tmp_dir}/instrumented" -isrc -XGHC2021 \
    "-O${optimization}" -Wall -Werror \
    -outputdir "${tmp_dir}/successor-O${optimization}" \
    test/CorrelatedSolverPrivate.hs \
    -o "${tmp_dir}/successor-O${optimization}-probe"
  # Three matrices per mode always run. Exact limits reach all three successor
  # evaluations; one-below limits reject the final reservation before its scan.
  for control in exact materialization work; do
    case "${control}" in
      exact) expected=6 ;;
      materialization|work) expected=4 ;;
    esac
    log_file="${tmp_dir}/successor-${control}-O${optimization}.log"
    if ! "${tmp_dir}/successor-O${optimization}-probe" "--successor-${control}" >"${log_file}" 2>&1; then
      cat "${log_file}" >&2
      exit 1
    fi
    check_event_count SOLVER_CANDIDATE_MATRIX 6 "${log_file}"
    check_event_count SOLVER_ELIMINATION 6 "${log_file}"
    check_event_count SOLVER_SUCCESSOR "${expected}" "${log_file}"
  done
  echo "PASS: D083 final successor reserves before completion at O${optimization}"

  cabal exec "${project_args[@]}" -- ghc \
    -package-env - -hide-all-packages -package base \
    "-i${tmp_dir}/instrumented" -isrc -XGHC2021 \
    "-O${optimization}" -Wall -Werror \
    -outputdir "${tmp_dir}/final-O${optimization}" \
    test/CorrelatedSolverGeometry.hs -o "${tmp_dir}/final-O${optimization}-probe"
  stages=(shadow device checker publication)
  events=(SOLVER_SHADOW SOLVER_DEVICE SOLVER_CHECKER SOLVER_REPORT_COMPARISON)
  for mode in ce cce; do
    for stage in "${!stages[@]}"; do
      for resource in work materialization; do
        for boundary in below exact; do
          log_file="${tmp_dir}/final-${mode}-${stage}-${resource}-${boundary}-O${optimization}.log"
          if ! "${tmp_dir}/final-O${optimization}-probe" --final-boundary "${mode}" "${stages[stage]}" "${resource}" "${boundary}" >"${log_file}" 2>&1; then
            cat "${log_file}" >&2
            exit 1
          fi
          admitted="${stage}"
          if [[ "${boundary}" == exact ]]; then admitted=$((admitted + 1)); fi
          for event in "${!events[@]}"; do
            expected=0
            if (( event < admitted )); then expected=1; fi
            check_event_count "${events[event]}" "${expected}" "${log_file}"
          done
        done
      done
    done
  done
  echo "PASS: D083 final verification bodies follow each reservation at O${optimization}"
done

# Measure constructor/checker operands and results against the production
# shadow and an independent fixture oracle. Disable sharing of probe effects;
# these are source-operation traces, not measurements of optimized allocation.
for variant in none reverse zero operands ce-labels cce-labels; do
  case "${variant}" in
    ce-labels) expected_failure='publication rejects CE owner' ;;
    cce-labels) expected_failure='publication rejects CCE owner' ;;
    *) expected_failure='ordered constructor/checker/shadow Rational trace' ;;
  esac
  python3 scripts/instrument-correlated-checker.py "${tmp_dir}/trace-${variant}" "${variant}"
  for optimization in 0 2; do
    cabal exec "${project_args[@]}" -- ghc \
      -package-env - -hide-all-packages -package base \
      "-i${tmp_dir}/trace-${variant}" -isrc -itest -XGHC2021 \
      "-O${optimization}" -fno-cse -fno-full-laziness -Wall -Werror \
      -outputdir "${tmp_dir}/trace-${variant}-O${optimization}" \
      test/CorrelatedSolverTrace.hs \
      -o "${tmp_dir}/trace-${variant}-O${optimization}-probe"
    log_file="${tmp_dir}/trace-${variant}-O${optimization}.log"
    if "${tmp_dir}/trace-${variant}-O${optimization}-probe" >"${log_file}" 2>&1; then
      if [[ "${variant}" != none ]]; then
        echo "Checker trace accepted the ${variant} mutation at O${optimization}." >&2
        exit 1
      fi
    elif [[ "${variant}" == none ]] || ! grep -F "${expected_failure}" "${log_file}" >/dev/null; then
      cat "${log_file}" >&2
      exit 1
    fi
    echo "PASS: D083 checker trace ${variant} control at O${optimization}"
  done
done
