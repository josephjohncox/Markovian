#!/usr/bin/env bash
set -euo pipefail

project_args=()
if [[ -f cabal.project && -f cabal.project.ci ]]; then
  project_args+=(--project-file=cabal.project.ci)
fi

tmp_dir="$(mktemp -d)"
trap 'rm -rf "${tmp_dir}"' EXIT
log_file="${tmp_dir}/feedback.log"
ghc_environment="${tmp_dir}/ghc.environment"
# GHC_ENVIRONMENT is expanded by the Cabal child shell.
# shellcheck disable=SC2016
cabal exec "${project_args[@]}" -- sh -c 'cp "$GHC_ENVIRONMENT" "$1"' sh "${ghc_environment}"
package_name="$(awk 'tolower($1) == "name:" { print $2; exit }' Markovian.cabal)"
package_version="$(awk 'tolower($1) == "version:" { print $2; exit }' Markovian.cabal)"
root_unit_id="${package_name}-${package_version}-inplace"
if [[ ! "${root_unit_id}" =~ ^Markovian-[0-9]+([.][0-9]+){3}-inplace$ ]]; then
  printf 'invalid active root package unit ID: %s\n' "${root_unit_id}" >&2
  exit 1
fi
isolated_package_args=(-package-env -)
while read -r package_db; do
  isolated_package_args+=(-package-db "${package_db}")
done < <(awk '$1 == "package-db" { print $2 }' "${ghc_environment}")

if cabal exec "${project_args[@]}" -- ghc \
  "${isolated_package_args[@]}" \
  -fno-code -fmax-errors=100 -hide-all-packages \
  -package base -package-id "${root_unit_id}" \
  test/compile-fail/FeedbackBoundary.hs >"${log_file}" 2>&1; then
  echo "Opaque feedback witnesses or nominal roles were accepted." >&2
  exit 1
fi

for rejected_operation in \
  badLoopLayoutConstructor \
  badCheckedFeedbackConstructor \
  badDelayedConstructor \
  badTimedConstructor \
  badAffineCoefficientsConstructor \
  badCheckedAffineFeedbackConstructor \
  badFeedbackEndpointCoerce \
  badFeedbackOwnerCoerce \
  badDelayedStateCoerce \
  badTimedLoopCoerce \
  badAffineOwnerCoerce \
  badAffineInputCoerce \
  badAffineLoopCoerce \
  badAffineOutputCoerce \
  badAffineCoefficientSourceCoerce \
  badAffineCoefficientOutputCoerce \
  badWitnessAsChannel \
  badAffineCoefficientsAsChannel \
  badAffineFiniteDiscount \
  UnsafeLoopLayout \
  UnsafeCheckedFeedback \
  UnsafeCheckedDelayedFeedback \
  UnsafeCheckedTimedFeedback \
  UnsafeAffineFeedbackCoefficients \
  UnsafeCheckedAffineFeedback; do
  if ! grep -F "${rejected_operation}" "${log_file}" >/dev/null; then
    cat "${log_file}" >&2
    echo "The expected ${rejected_operation} boundary error was absent." >&2
    exit 1
  fi
done

if ! grep -F "Couldn't match" "${log_file}" >/dev/null; then
  cat "${log_file}" >&2
  echo "The fixture did not demonstrate nominal feedback endpoint protection." >&2
  exit 1
fi

echo "PASS: feedback witness and coefficient opacity, nominal roles, and channel separation"
