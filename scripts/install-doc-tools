#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
# shellcheck source=../toolchain.env
source "$project_root/toolchain.env"

install_root="$project_root/.direnv"
mdbook_bin="$install_root/bin/mdbook"
expected="mdbook v${MARKOVIAN_MDBOOK_VERSION}"

if [[ -x "$mdbook_bin" ]] && [[ "$("$mdbook_bin" --version)" == "$expected" ]]; then
  echo "$expected is already installed at $mdbook_bin"
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "Cargo is required to install $expected." >&2
  exit 1
fi

cargo install \
  mdbook \
  --version "$MARKOVIAN_MDBOOK_VERSION" \
  --locked \
  --root "$install_root"

test "$("$mdbook_bin" --version)" = "$expected"
echo "Installed $expected at $mdbook_bin"
